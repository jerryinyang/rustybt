  <acceptanceCriteria>
    <criterion id="1" title="BUG classification workflow in CLI">
      <requirement>Press 'b' during investigation to classify as BUG</requirement>
      <requirement>Prompt for required rationale (non-empty)</requirement>
      <requirement>Prompt for affected component(s) (at least one)</requirement>
      <requirement>Prompt for severity level (Critical/Major/Minor)</requirement>
      <requirement>Optional: prompt for suggested fix</requirement>
    </criterion>
    <criterion id="2" title="Finding model updated with BUG fields">
      <requirement>`classification = "BUG"`</requirement>
      <requirement>`rationale` (required, non-empty string)</requirement>
      <requirement>`severity` (Critical/Major/Minor)</requirement>
      <requirement>`affected_components` (list of file paths)</requirement>
      <requirement>`suggested_fix` (optional string)</requirement>
      <requirement>`investigated_by` (user identifier)</requirement>
      <requirement>`investigated_at` (timestamp)</requirement>
    </criterion>
    <criterion id="3" title="Validation requirements">
      <requirement>Rationale cannot be empty or whitespace-only</requirement>
      <requirement>At least one affected component required</requirement>
      <requirement>Severity must be valid enum value</requirement>
      <requirement>Validation errors shown clearly with retry prompt</requirement>
    </criterion>
    <criterion id="4" title="Persistence to findings.yaml">
      <requirement>Classification saved immediately after input</requirement>
      <requirement>Preserve existing findings in file</requirement>
      <requirement>YAML format readable and editable</requirement>
    </criterion>
    <criterion id="5" title="Classification confirmation">
      <requirement>Show summary of classification before saving</requirement>
      <requirement>Display next steps for bug fixing</requirement>
      <requirement>Update progress indicator (unclassified count)</requirement>
    </criterion>
    <criterion id="6" title="Unit tests verify">
      <requirement>Classification workflow prompts</requirement>
      <requirement>Validation of required fields</requirement>
      <requirement>Persistence to YAML</requirement>
      <requirement>Model field updates</requirement>
    </criterion>
  </acceptanceCriteria>

