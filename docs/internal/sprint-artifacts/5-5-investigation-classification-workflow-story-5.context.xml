  </story>

  <acceptanceCriteria>
    <criterion id="1" title="Verify CLI command implemented">
      <requirement>`rustybt-validate verify &lt;finding_id&gt;` invokes verification</requirement>
      <requirement>Displays original discrepancy details</requirement>
      <requirement>Re-runs strategy execution for both frameworks</requirement>
      <requirement>Re-runs layer comparison for affected layer</requirement>
      <requirement>Reports verification result (pass/fail)</requirement>
    </criterion>
    <criterion id="2" title="Strategy re-execution">
      <requirement>Locate original session with same parameters</requirement>
      <requirement>Re-execute rustybt strategy with identical config</requirement>
      <requirement>Re-execute Backtrader strategy with identical config</requirement>
      <requirement>Capture new logs to temporary location</requirement>
    </criterion>
    <criterion id="3" title="Layer re-comparison">
      <requirement>Run comparison only for the finding's layer</requirement>
      <requirement>Use same tolerance configuration</requirement>
      <requirement>Check if original discrepancy still present</requirement>
    </criterion>
    <criterion id="4" title="Verification pass handling">
      <requirement>If discrepancy no longer present → verification passes</requirement>
      <requirement>Update finding: `resolved = True`, `resolved_at = datetime.now()`</requirement>
      <requirement>Store path to regression test (created in Story 5.6)</requirement>
      <requirement>Display success message with next steps</requirement>
    </criterion>
    <criterion id="5" title="Verification fail handling">
      <requirement>If discrepancy still present → verification fails</requirement>
      <requirement>Display current values vs expected</requirement>
      <requirement>Keep finding status unchanged</requirement>
      <requirement>Suggest debugging steps</requirement>
    </criterion>
    <criterion id="6" title="Unit tests verify">
      <requirement>CLI command parsing</requirement>
      <requirement>Strategy re-execution logic</requirement>
      <requirement>Comparison result handling</requirement>
      <requirement>Finding update on pass/fail</requirement>
    </criterion>
  </acceptanceCriteria>

