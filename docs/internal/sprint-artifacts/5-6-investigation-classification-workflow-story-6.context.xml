  <acceptanceCriteria>
    <criterion id="1" title="Regression test generation on verification pass">
      <requirement>When `rustybt-validate verify` passes, auto-generate regression test</requirement>
      <requirement>Test file created at `tests/validation/regression/test_&lt;finding_id&gt;.py`</requirement>
      <requirement>Test is immediately runnable with pytest</requirement>
    </criterion>
    <criterion id="2" title="Generated test structure">
      <requirement>Docstring includes original finding details (ID, layer, event, values)</requirement>
      <requirement>Docstring includes fix date and fix description</requirement>
      <requirement>Test uses appropriate pytest markers (`@pytest.mark.regression`, `@pytest.mark.layer_X_*`)</requirement>
      <requirement>Test loads strategy logs and runs layer comparison</requirement>
      <requirement>Assertion checks specific event type from finding</requirement>
    </criterion>
    <criterion id="3" title="Test content requirements">
      <requirement>Reference to original finding ID</requirement>
      <requirement>Original discrepancy details (rustybt_value, backtrader_value)</requirement>
      <requirement>Fix date and affected_components</requirement>
      <requirement>Meaningful test name from finding ID</requirement>
      <requirement>Clear assertion message referencing original bug</requirement>
    </criterion>
    <criterion id="4" title="Regression test directory">
      <requirement>Create `tests/validation/regression/` if not exists</requirement>
      <requirement>Add `__init__.py` for package</requirement>
      <requirement>Add `conftest.py` with shared fixtures if needed</requirement>
    </criterion>
    <criterion id="5" title="CI integration">
      <requirement>Regression tests run in CI with `pytest tests/validation/regression/`</requirement>
      <requirement>Regression test failures block CI</requirement>
      <requirement>Separate from main layer tests for clarity</requirement>
    </criterion>
    <criterion id="6" title="Unit tests verify">
      <requirement>Test file generation</requirement>
      <requirement>Generated test syntax is valid Python</requirement>
      <requirement>Generated test runs without errors</requirement>
      <requirement>Test assertions are correct</requirement>
    </criterion>
  </acceptanceCriteria>

