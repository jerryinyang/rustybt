  <story>
    <asA>validation framework developer</asA>
    <iWant>to run the full 5-layer validation test suite with the reimplemented rustybt strategies and verify comparators work correctly with real rustybt logs</iWant>
    <soThat>we can confirm the validation framework produces accurate comparisons and all discrepancies are properly investigated and classified</soThat>
    <tasks>
      <task id="1" title="Prepare Test Environment">
        <subtask>Ensure validation fixture is generated and accessible</subtask>
        <subtask>Verify all 4 rustybt strategies are reimplemented (X.5, X.6)</subtask>
        <subtask>Verify Backtrader strategies are unchanged and working</subtask>
        <subtask>Review tolerance configurations</subtask>
      </task>
      <task id="2-6" title="Run Layer 1-5 Tests" ac="1,2,3">
        <subtask>Execute pytest tests/validation/test_layer_1_data.py</subtask>
        <subtask>Execute pytest tests/validation/test_layer_2_signals.py</subtask>
        <subtask>Execute pytest tests/validation/test_layer_3_orders.py</subtask>
        <subtask>Execute pytest tests/validation/test_layer_4_broker.py</subtask>
        <subtask>Execute pytest tests/validation/test_layer_5_portfolio.py</subtask>
      </task>
      <task id="7-8" title="Investigate and Classify Findings" ac="4">
        <subtask>For each discrepancy, determine root cause</subtask>
        <subtask>Classify as BUG or DESIGN</subtask>
        <subtask>Document rationale for each classification</subtask>
      </task>
      <task id="9" title="Verify No False Positives" ac="5">
        <subtask>Review tolerance configurations</subtask>
        <subtask>Adjust tolerances if legitimate differences are being flagged</subtask>
        <subtask>Re-run tests after adjustments</subtask>
      </task>
    </tasks>
  </story>

  <acceptanceCriteria>
    <criterion id="AC-X7.1" title="Layer 1 tests execute without errors">
      <requirement>test_layer_1_data.py runs successfully</requirement>
      <requirement>Bar counts match between frameworks</requirement>
      <requirement>Timestamps align (within tolerance)</requirement>
    </criterion>
    <criterion id="AC-X7.2" title="Layer 2 indicator values compared correctly">
      <requirement>test_layer_2_signals.py runs successfully</requirement>
      <requirement>SMA, RSI, EMA, MACD values compared</requirement>
      <requirement>Known DESIGN differences documented</requirement>
    </criterion>
    <criterion id="AC-X7.3" title="Layers 3-5 tests execute and compare correctly">
      <requirement>test_layer_3_orders.py runs successfully</requirement>
      <requirement>test_layer_4_broker.py runs successfully</requirement>
      <requirement>test_layer_5_portfolio.py runs successfully</requirement>
    </criterion>
    <criterion id="AC-X7.4" title="All findings classified as BUG or DESIGN">
      <requirement>Every discrepancy has a classification</requirement>
      <requirement>Rationale documented for each classification</requirement>
      <requirement>No unclassified findings remain</requirement>
    </criterion>
    <criterion id="AC-X7.5" title="Zero false positives">
      <requirement>Tolerance configurations appropriate</requirement>
      <requirement>Known differences documented, not flagged as errors</requirement>
      <requirement>Test assertions accurate</requirement>
    </criterion>
  </acceptanceCriteria>

